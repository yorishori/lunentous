<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed for ConnectivityManager.registerNetworkCallback, used to
         trigger an outbox sync attempt as soon as connectivity returns. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required to post the due/overdue reminder notifications
         PullSyncWorker's periodic poll produces (see
         data/notifications/ReminderNotifier.kt); requested at runtime from
         MainActivity, not implicitly granted below API 33. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera capture (ui/camera/CameraCapture.kt) delegates to the
         system camera app via an implicit intent rather than an in-app
         CameraX preview, so this app itself never needs the CAMERA
         permission, just package-visibility to find a camera app on
         API 30+. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- The server has no built-in TLS (README.md's Network exposure note);
         users reach it over plain HTTP via LAN/WireGuard/reverse proxy.
         Android blocks cleartext traffic by default since API 28. -->
    <application
        android:name=".LunentousApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Grants the system camera app temporary access to write into
             our app-private files/photos/ dir, see res/xml/file_paths.xml
             and ui/camera/CameraCapture.kt. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
